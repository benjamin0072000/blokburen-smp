---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/pages.css';
import {site, asset} from '../config/site';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
interface Props { title?: string; description?: string; }
const {title = 'BlokBuren SMP | Nederlandse Minecraft survival server', description = site.description} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const jsonLd = {'@context':'https://schema.org','@type':'WebSite',name:site.name,description,inLanguage:'nl-NL',...(canonical ? {url:canonical} : {})};
---
<!doctype html><html lang="nl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={site.seo.indexable ? 'index,follow' : 'noindex,nofollow'}/><meta name="theme-color" content="#faf8f2"/><link rel="icon" type="image/png" href={asset('images/favicon.png')}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:locale" content="nl_NL"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{canonical && <meta property="og:url" content={canonical}/>}<meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g,'\\u003c')}/><script is:inline>
  (() => {
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    let preference = null;
    try { preference = localStorage.getItem('blokburen-theme'); } catch {}
    const apply = (dark) => {
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#00062d' : '#faf8f2');
      const button = document.querySelector('.theme-toggle');
      button?.setAttribute('aria-pressed', String(dark));
      button?.setAttribute('title', dark ? 'Schakel naar dagmodus' : 'Schakel naar nachtmodus');
    };
    const isDark = () => preference === 'dark' || (preference !== 'light' && media.matches);
    apply(isDark());
    media.addEventListener('change', () => { if (preference !== 'dark' && preference !== 'light') apply(media.matches); });
    document.addEventListener('DOMContentLoaded', () => {
      apply(isDark());
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('blokburen-theme', preference); } catch {}
        apply(preference === 'dark');
      });
    });
  })();
</script></head><body><a href="#inhoud" class="skip-link">Naar de inhoud</a><Navigation/><main id="inhoud"><slot/></main><Footer/><Analytics/></body></html>
