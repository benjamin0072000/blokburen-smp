---
import {getCollection} from 'astro:content';
import {site} from '../config/site';
const updates = (await getCollection('news')).sort((a,b) => a.data.order - b.data.order);
---
<section id="nieuws" class="community wrap section-space"><div class="community-heading"><p class="eyebrow">SERVERUPDATES</p><h2>Wat speelt er?</h2><p>Hier delen we straks servernieuws, builds en nieuwe shops. Tot die tijd praten we bij op Discord.</p></div>{updates.slice(0,1).map(({data}) => <article class="community-note"><div class="note-label">{data.category}<span>{data.preview ? 'BINNENKORT' : 'NIEUWS'}</span></div><h3>{data.title}</h3><p>{data.summary}</p><a class="text-link" href={site.discord} target="_blank" rel="noopener noreferrer">Praat mee op Discord <span aria-hidden="true">↗</span></a></article>)}</section>
