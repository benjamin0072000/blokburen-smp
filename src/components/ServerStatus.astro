---
import {site} from '../config/site';
const {server,status} = site;
const placeholder = status.mode === 'placeholder';
---
<section id="spelen" class="server-bar wrap" aria-label="Meespelen en serverstatus"><div class="server-state"><span class:list={['status-dot', {live: !placeholder && status.online}]}></span><div><strong>{placeholder ? 'De buurt wordt klaargemaakt' : status.online ? 'De server is online' : 'De server is offline'}</strong><span>{placeholder ? 'Publiek serveradres volgt. Praat alvast mee op Discord.' : `${status.players ?? '—'} / ${status.maxPlayers ?? '—'} spelers · ${status.version ?? server.edition}`}</span></div></div><div class="server-address"><span>{server.addressIsPlaceholder ? 'SERVERADRES BINNENKORT' : 'JOUW WEG NAAR DE BUURT'}</span>{server.addressIsPlaceholder ? <strong>We houden een plek voor je vrij.</strong> : <button class="copy-ip" data-address={server.address}>{server.address}<span aria-hidden="true">⧉</span></button>}</div><p class="copy-feedback" role="status" aria-live="polite"></p></section>
<script>
  document.querySelector<HTMLButtonElement>('.copy-ip')?.addEventListener('click', async event => {const button = event.currentTarget as HTMLButtonElement; const feedback = document.querySelector<HTMLElement>('.copy-feedback'); try {await navigator.clipboard.writeText(button.dataset.address || ''); if(feedback) feedback.textContent = 'Serveradres gekopieerd. Voeg het toe via Multiplayer in Minecraft Java.';} catch {if(feedback) feedback.textContent = `Kopieer het adres handmatig: ${button.dataset.address}`;} });
</script>
