---
import Button from './Button.astro';
import {site, asset} from '../config/site';
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy"><p class="eyebrow"><span class="little-block" aria-hidden="true"></span> NEDERLANDSE MINECRAFT SURVIVAL</p><h1 id="hero-title">Waar survival<br/><span>samen</span> begint<span class="orange">.</span></h1><p class="hero-description">Een eigen plek. Bekende gezichten. En altijd iets om te bouwen. Vind je thuis in de survivalwereld van BlokBuren SMP.</p><div class="actions"><Button href="#spelen">Speel nu</Button><Button href={site.discord} secondary external>Join onze Discord</Button></div><p class="hero-facts"><span>Java Edition</span><span>Geen whitelist</span><span>Geen pay-to-win</span></p></div>
  <figure class="hero-world"><img src={asset(site.assets.hero)} alt={site.assets.heroIsIllustration ? 'Sfeerillustratie van een Minecraft-buurt met blokhuizen, een akker en groene bomen' : 'Een kijkje in de survivalwereld van BlokBuren SMP'} width="1536" height="1024" fetchpriority="high" /><div class="world-label"><span aria-hidden="true">⌖</span><div>Hier is plek voor jou.<small>Een wereld om samen op te bouwen</small></div></div><figcaption>{site.assets.heroIsIllustration ? 'Sfeerillustratie · onze echte wereld volgt' : 'Een kijkje bij de BlokBuren'}</figcaption></figure>
</section>
