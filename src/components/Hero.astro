---
import Button from './Button.astro';
import {site, asset} from '../config/site';
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy"><p class="eyebrow"><span class="little-block" aria-hidden="true"></span> NEDERLANDSE MINECRAFT SURVIVAL</p><h1 id="hero-title">Gewoon survival.<br/><span>Met</span> je buren<span class="orange">.</span></h1><p class="hero-description">Bouw je base, ga minen en verkoop je loot aan andere spelers. Een Nederlandse Java-server waar je solo kunt spelen of samen met je buren.</p><div class="actions"><Button href="#spelen">Speel nu</Button><Button href={site.discord} secondary external>Join onze Discord</Button></div><p class="hero-facts"><span>Java Edition</span><span>Geen whitelist</span><span>Geen pay-to-win</span></p></div>
  <figure class="hero-world"><img src={asset(site.assets.hero)} alt={site.assets.heroIsIllustration ? 'Voorbeeld van een Minecraft-dorp; echte serverscreenshots volgen nog' : 'Huizen en builds op BlokBuren SMP'} width="1536" height="1024" fetchpriority="high" /><div class="world-label"><span aria-hidden="true">⌖</span><div>Waar bouw jij je base?<small>Solo of samen, allebei prima</small></div></div><figcaption>{site.assets.heroIsIllustration ? 'In-game screenshots volgen zodra de server live gaat!' : 'Zo ziet het er in-game uit'}</figcaption></figure>
</section>
