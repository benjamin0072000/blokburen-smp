---
import {site} from '../config/site';
const active = import.meta.env.PROD && site.analytics.enabled && /^G-[A-Z0-9]+$/.test(site.analytics.measurementId);
---
{active && <aside class="consent" aria-label="Privacykeuze" data-id={site.analytics.measurementId} hidden><p>Met anonieme bezoekstatistieken helpen we de website verbeteren. Wil je statistiekcookies toestaan?</p><button data-consent="yes">Toestaan</button><button data-consent="no">Nee, bedankt</button></aside>}
<script>
  const banner = document.querySelector<HTMLElement>('.consent');
  if(banner) {
    const start = () => {const id=banner.dataset.id; const w=window as Window & {dataLayer?: unknown[];gtag?:(...args:unknown[])=>void}; w.dataLayer=w.dataLayer||[]; w.gtag=function(){w.dataLayer!.push(arguments);}; w.gtag('js',new Date());w.gtag('config',id,{allow_google_signals:false,allow_ad_personalization_signals:false}); const script=document.createElement('script');script.async=true;script.src=`https://www.googletagmanager.com/gtag/js?id=${id}`;document.head.appendChild(script);};
    let choice: string|null=null;try{choice=localStorage.getItem('bb-analytics');}catch{}
    if(choice==='yes')start();else if(choice!=='no')banner.hidden=false;
    banner.querySelectorAll<HTMLButtonElement>('button').forEach(button=>button.addEventListener('click',()=>{const choice=button.dataset.consent!;try{localStorage.setItem('bb-analytics',choice);}catch{}banner.hidden=true;if(choice==='yes')start();}));
  }
</script>
